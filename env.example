# Threadlock Production Environment Variables
THREADLOCK_ENV=production
THREADLOCK_DB_PATH=.threadlock/threadlock.db
THREADLOCK_AUDIT_PATH=.threadlock/audit.jsonl
THREADLOCK_SIGNING_KEY_PATH=.threadlock/signing_key.pem

# Security & Auth (Generate strong 32+ char random secrets)
THREADLOCK_API_KEY=replace_with_32_byte_random_token
ALLOWED_ORIGINS=https://threadlock.app,http://localhost:8000

# Webhook Signing Secrets
WHATSAPP_WEBHOOK_SECRET=replace_with_meta_app_secret
SLACK_SIGNING_SECRET=replace_with_slack_signing_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
STRIPE_WEBHOOK_SECRET=replace_with_stripe_whsec_secret

# Optional Live ZDR LLM Keys (Deterministic offline engine works even if unset)
ANTHROPIC_API_KEY=
GEMINI_API_KEYS=

# Real OAuth 2.0 App Credentials (Server-Side Only)
THREADLOCK_PUBLIC_URL=https://threadlock.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
